+static int readNumber (FILE* file, const char* format, int* out) { // format: " %lld " or " d %lld "
+  long long v; int tmp = fscanf (file, format, &v);
+  if (tmp != 1) return tmp;
+  if (v > 2147483647LL || v < -2147483647LL) { printf ("c ERROR: number %lld out of range\n", v); exit (2); }
+  *out = (int) v; return 1; }
